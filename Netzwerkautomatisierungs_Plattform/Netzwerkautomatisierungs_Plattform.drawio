        <UserObject label="&lt;img src=&quot;https://www.open-scap.org/wp-content/themes/openscap/img/banner-3.svg&quot; alt=&quot;ecosystem1&quot;&gt;" id="AeZdqWY17jVozvtXn1Vt-1">
