        <mxCell id="1MM_5qwWWJNTJ9KU7V04-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="770" width="1751.37" x="2880" y="10800" as="geometry" />
